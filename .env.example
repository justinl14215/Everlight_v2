# Required outside development local mode. Generate SESSION_SECRET with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-32-byte-secret
DM_PASSWORD=replace-with-a-long-unique-password

# Optional live AI Dungeon Master. Keep the key server-side; never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=replace-with-your-server-side-api-key
OPENAI_MODEL=gpt-6.2-sol

# Production persistence (Supabase project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-secret

# Optional: set to 0 to disable development local store.
EVERLIGHT_LOCAL_MODE=1
